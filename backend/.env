# TrueFoundry AI Gateway settings
# Replace these after creating your AI Gateway endpoint / virtual model in TrueFoundry.
TRUEFOUNDRY_API_KEY=your_truefoundry_gateway_key
TRUEFOUNDRY_GATEWAY_BASE_URL=https://your-gateway-url.openai.azure-compatible-or-openai-compatible/v1
TRUEFOUNDRY_VIRTUAL_MODEL=promptshield-router

# Local backend settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
